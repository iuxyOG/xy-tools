{
  "name": "value-ai-frontend-beta",
  "private": true,
  "version": "0.1.0-beta",
  "scripts": {
    "dev": "next dev -p 3001",
    "lint": "eslint .",
    "lint:encoding": "node ../scripts/check-encoding.js src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "cross-env NODE_PATH=./node_modules NEXT_DISABLE_ESLINT=true next build",
    "start": "next start"
  },
  "dependencies": {
    "framer-motion": "^12.23.26",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@typescript-eslint/parser": "^8.10.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "prettier": "^3.3.3",
    "typescript": "5.9.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "next/core-web-vitals"
    ],
    "rules": {
      "react-hooks/rules-of-hooks": "warn"
    }
  }
}
